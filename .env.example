# Docker Compose (ports 5433/6380 avoid conflicts with local Postgres/Redis)
DATABASE_URL=postgresql+asyncpg://note:note@localhost:5433/note
DATABASE_URL_SYNC=postgresql://note:note@localhost:5433/note
REDIS_URL=redis://localhost:6380/0

# If using existing local Redis on 6379 instead of Docker:
# REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# AI (optional in dev — heuristics still run)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# App
ENVIRONMENT=development
CORS_ORIGINS=*
WEB_BASE_URL=http://localhost:8081
